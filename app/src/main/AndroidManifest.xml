<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.futbolstats">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="FutNanCat"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">

        <meta-data
            android:name="com.google.firebase.analytics.default_analytics_collection_enabled"
            android:value="true" />

        <!-- 🔐 LOGIN (LAUNCHER) -->
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 🏠 APP PRINCIPAL -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".PlayerDetailActivity"
            android:exported="false" />

        <activity
            android:name=".EditStatsActivity"
            android:exported="false" />

        <activity
            android:name=".AddPlayerActivity"
            android:exported="false" />
        <activity
            android:name=".EditGoalkeeperStatsActivity"
            android:exported="false" />

    </application>
</manifest>
