<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.futbolstats">

    <!-- Necesario para Firebase + carga de imágenes (Picasso) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Futbol Stats"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">

        <!-- 🔥 Firebase Analytics (si lo usas) -->
        <meta-data
            android:name="com.google.firebase.analytics.default_analytics_collection_enabled"
            android:value="true" />

        <!-- 🏠 Activity principal (lista de jugadores) -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 📊 Detalle del jugador con radar -->
        <activity
            android:name=".PlayerDetailActivity"
            android:exported="false" />

        <!-- ➕➖ Edición de estadísticas -->
        <activity
            android:name=".EditStatsActivity"
            android:exported="false" />
        <activity
            android:name=".AddPlayerActivity"
            android:exported="false"/>

    </application>

</manifest>
